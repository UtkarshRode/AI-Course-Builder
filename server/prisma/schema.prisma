generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  INSTRUCTOR
  ADMIN
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  THEORY
  EXAMPLE
  EXERCISE
  PROJECT
  ASSESSMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(LEARNER)

  profile LearnerProfile?

  courses     Course[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearnerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  experienceLevel     ExperienceLevel @default(BEGINNER)
  weeklyHours         Int?
  learningGoal        String?
  preferredDifficulty String?
  targetDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id             String          @id @default(uuid())
  title          String
  description    String?
  status         CourseStatus    @default(DRAFT)
  difficulty     ExperienceLevel @default(BEGINNER)
  estimatedHours Int?

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  modules     Module[]
  concepts    CourseConcept[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
}

model Module {
  id          String  @id @default(uuid())
  title       String
  description String?
  position    Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, position])
}

model Lesson {
  id               String     @id @default(uuid())
  title            String
  description      String?
  content          String?
  position         Int
  type             LessonType @default(THEORY)
  estimatedMinutes Int?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  concepts LessonConcept[]
  progress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, position])
}

model Concept {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  courses CourseConcept[]
  lessons LessonConcept[]

  prerequisites ConceptPrerequisite[] @relation("ConceptPrerequisites")
  dependents    ConceptPrerequisite[] @relation("ConceptDependents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseConcept {
  courseId  String
  conceptId String

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([courseId, conceptId])
}

model LessonConcept {
  lessonId  String
  conceptId String

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([lessonId, conceptId])
}

model ConceptPrerequisite {
  conceptId      String
  prerequisiteId String

  concept      Concept @relation("ConceptPrerequisites", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("ConceptDependents", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([conceptId, prerequisiteId])
}

model Enrollment {
  id          String           @id @default(uuid())
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  progress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  completed   Boolean   @default(false)
  completedAt DateTime?

  enrollmentId String
  lessonId     String

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model ConceptMastery {
  id        String @id @default(uuid())
  userId    String
  courseId  String
  conceptId String

  masteryScore   Float @default(0)
  attempts       Int   @default(0)
  correctAnswers Int   @default(0)
  totalAnswers   Int   @default(0)

  lastScore     Float     @default(0)
  lastAttemptAt DateTime?

  status String @default("WEAK")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId, conceptId])
  @@index([userId, courseId])
}

model Assessment {
  id String @id @default(uuid())

  courseId String
  lessonId String?

  title       String
  description String?

  questions Json

  passingScore Float @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts AssessmentAttempt[]
}

model AssessmentAttempt {
  id String @id @default(uuid())

  assessmentId String
  userId       String
  courseId     String

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  score          Float
  totalQuestions Int
  correctAnswers Int

  answers Json

  completedAt DateTime @default(now())

  @@index([userId, courseId])
  @@index([assessmentId])
}

model LearningRecommendation {
  id String @id @default(uuid())

  userId   String
  courseId String

  conceptId String
  lessonId  String?

  reason   String
  priority Float

  status String @default("PENDING")

  createdAt DateTime @default(now())
}

model LearningAgentPlan {
  id String @id @default(uuid())

  userId   String
  courseId String

  priority String
  action   String

  reason       String
  learningPlan String
  practiceTask String?

  recommendedLessonId String?

  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, courseId])
  @@index([courseId])
}
